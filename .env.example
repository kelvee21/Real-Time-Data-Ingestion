# copy to .env and fill in. .env is gitignored, never commit it.
PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=spark_app
PGPASSWORD=

# streaming job knobs (see reports/performance_metrics.md).
# relative folders are taken from the lab folder (src/config.py)
INPUT_DIR=data/incoming
CHECKPOINT_DIR=checkpoint/events
METRICS_DIR=metrics
TRIGGER=5 seconds
MAX_FILES=1

# spark
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=4
SPARK_LOG_LEVEL=WARN
# windows only, the folder above bin\winutils.exe. only needed if it is not
# already a user env var (get_spark reads that one from the registry too)
# HADOOP_HOME=C:\Users\User\hadoop
